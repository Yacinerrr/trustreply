# Copy to .env and fill in ONE key. Never commit .env.

# Option 1: Groq (https://console.groq.com)
GROQ_API_KEY=

# Option 2: Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional. If both keys are set, choose which to use: groq or anthropic.
# TRUSTREPLY_PROVIDER=groq

# Optional. Leave unset to use each provider's default model
# (Groq: llama-3.3-70b-versatile, Anthropic: claude-sonnet-5-5).
# TRUSTREPLY_MODEL=
